# Copie para .env.local e preencha. Nunca faça commit de .env ou .env.local.

# IA (a partir do Marco 3). A chave fica só no servidor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Banco: conexão direta ao Postgres. No Supabase, use a string de conexão do
# pooler em modo transação (porta 6543) para o servidor e a conexão direta
# (porta 5432) para rodar as migrações.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mesa_dev
# Banco usado pelos testes de integração (é apagado e recriado a cada teste).
DATABASE_URL_TESTE=postgres://postgres:postgres@localhost:5432/mesa_teste

# Tempo real pelo Supabase Realtime. Se ficar vazio, a aplicação usa o canal
# local (SSE dentro do próprio servidor), que só serve para um único processo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço que os QR codes abrem no celular, por exemplo https://oficina.vercel.app
# Se ficar vazio, vale o endereço que o navegador usou. Quando o navegador abriu
# por localhost, o QR usa o endereço do computador na rede Wi-Fi.
URL_PUBLICA=

# Acesso ao admin.
ADMIN_PASSWORD=
FACILITADOR_PASSWORD=
# Texto longo e aleatório para assinar o cookie do admin.
SESSION_SECRET=
